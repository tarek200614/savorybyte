# Application Configuration
PROJECT_NAME="SavoryByte Restaurant Reservation API"
API_V1_STR="/api/v1"
ENVIRONMENT="development"

# Security & Secrets
SECRET_KEY="super_secret_jwt_key_change_in_production_123456789"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection (Async PostgreSQL)
DATABASE_URL="postgresql+asyncpg://savory_user:savory_password@localhost:5432/savorybyte_db"

# CORS Configuration (JSON array string)
CORS_ORIGINS='["http://localhost:5173", "http://localhost:3000"]'
